# Send no unlisted files to a local or remote Docker builder.
**

# These exclusions document particularly sensitive or runtime-only paths.
.env*
certs/
tests/
.git/
workspace/
traces/
.workspace-reset-*

# Minimal build context.
!Dockerfile
!.dockerignore
!pyproject.toml
!README.md
!.env.example
!workspace_agent/
!workspace_agent/**
!static/
!static/**
!demo_workspace_seed/
!demo_workspace_seed/**

# Docker uses the last matching rule, so re-exclude nested secrets here.
**/.env
**/.env.*
**/*.pem
**/*.key
**/id_rsa

# The Dockerfile needs this committed, empty-key example configuration.
!.env.example
